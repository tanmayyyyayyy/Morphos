PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

# Google Gemini API Key for LangGraph Autonomous Investigations
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Web Configuration (Public Client SDK)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=1234567890
FIREBASE_APP_ID=1:1234567890:web:your_app_id
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Vite Frontend Environment Variables (mirrors above for Vite client build)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:your_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Backend API URL (leave unset for local dev to use http://localhost:4000)
# Set this to your production backend URL when deploying
VITE_API_URL=https://your-backend-url.com

# Optional Firebase Admin SDK Service Account credentials (for server-side Firestore operations)
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"
